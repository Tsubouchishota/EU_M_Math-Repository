        "from sklearn.linear_model import Lasso\n",
        "from sklearn.metrics import r2_score\n",
        "\n",
        "# Lasso回帰モデルのインスタンス化 (デフォルトのalpha=1.0)\n",
        "lasso_model = Lasso(random_state=0, alpha=1.0)\n",
        "\n",
        "# モデルの訓練\n",
        "lasso_model.fit(x_train, y_train)\n",
        "\n",
        "# 訓練データでの予測とR^2スコアの計算\n",
        "y_train_pred_lasso = lasso_model.predict(x_train)\n",
        "r2_train_lasso = r2_score(y_train, y_train_pred_lasso)\n",
        "\n",
        "# テストデータでの予測とR^2スコアの計算\n",
        "y_test_pred_lasso = lasso_model.predict(x_test)\n",
        "r2_test_lasso = r2_score(y_test, y_test_pred_lasso)\n",
        "\n",
        "print(f\"Lassoモデル (訓練データ) でのR^2スコア: {r2_train_lasso:.4f}\")\n",
        "print(f\"Lassoモデル (テストデータ) でのR^2スコア: {r2_test_lasso:.4f}\")\n",
        "print(f\"\\nLassoモデルの回帰係数:\\n{pd.Series(lasso_model.coef_, index=x.columns)}\")\n",
        "print(f\"Lassoモデルの切片: {lasso_model.intercept_:.3f}\")"
      ],
