        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.interpolate import interp1d # interp1dをインポート\n",
        "\n",
        "x=np.linspace(0,10,num=11,endpoint=True)\n",
        "y=np.sin(x**2/5.0)\n",
        "\n",
        "# 古い線形補間コード（x_interp, y_interp）は、新しい比較プロットのために削除またはコメントアウトします\n",
        "# 新しいx座標を生成\n",
        "xnew=np.linspace(0,10,num=30,endpoint=True)\n",
        "\n",
        "# 線形補間関数を定義\n",
        "f_linear = interp1d(x,y,'linear')\n",
        "# 3次補間関数を定義 (f2をf_cubicに変更)\n",
        "f_cubic = interp1d(x,y,'cubic')\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "# 元のデータ、線形補間、3次補間を同時にプロット\n",
        "plt.plot(x,y,'o',                         # 元のデータ\n",
        "         xnew,f_linear(xnew),'-',         # 線形補間\n",
        "         xnew,f_cubic(xnew),'--')         # 3次補間\n",
        "plt.legend(['data','linear','cubic'],loc='best')\n",
        "plt.grid(True)\n",
        "plt.title('Comparison of Linear and Cubic Interpolation')\n",
        "plt.xlabel('x')\n",
        "plt.ylabel('y')\n",
        "plt.show()"
