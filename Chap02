        "import numpy as np\n",
        "import math\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "# 1. 一様乱数を発生させる\n",
        "\n",
        "N = 10000\n",
        "\n",
        "# 区間[0,1]上の一様分布に従う乱数を2組（x, y）それぞれ10,000個作成\n",
        "x = np.random.uniform(0.0, 1.0, N)\n",
        "y = np.random.uniform(0.0, 1.0, N)\n",
        "\n",
        "# 2. 円の内部に入る点の数を数え、プロットする\n",
        "\n",
        "count_inside = 0\n",
        "\n",
        "inside_x = []\n",
        "inside_y = []\n",
        "outside_x = []\n",
        "outside_y = []\n",
        "\n",
        "for i in range(N):\n",
        "    distance = math.hypot(x[i], y[i])\n",
        "\n",
        "    if distance < 1:\n",
        "        count_inside += 1\n",
        "        inside_x.append(x[i])\n",
        "        inside_y.append(y[i])\n",
        "    else:\n",
        "        outside_x.append(x[i])\n",
        "        outside_y.append(y[i])\n",
        "\n",
        "print(f\"円の内部に入る点の数: {count_inside}組\")\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "\n",
        "plt.scatter(inside_x, inside_y, color='red', s=1, label='Inside')\n",
        "\n",
        "plt.scatter(outside_x, outside_y, color='blue', s=1, label='Outside')\n",
        "\n",
        "plt.title(\"Monte Carlo Method\")\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"y\")\n",
        "plt.legend(loc=\"upper right\")\n",
        "plt.axis('equal')\n",
        "plt.show()\n",
        "\n",
        "# 3. 円周率を求める\n",
        "\n",
        "pi_estimate = 4 * count_inside / N\n",
        "\n",
        "print(f\"推定された円周率: {pi_estimate}\")"
      ]
